// -*- C++ -*-
#ifndef _VXCXX_UTILITY
#define _VXCXX_UTILITY

/*
 * <utility> — move, forward, and pair.
 *
 * move and forward are the two functions in the standard library that do
 * nothing at all: both compile to no instructions and both exist to
 * change what the *compiler* does with an expression. move says "you may
 * take this apart"; forward says "pass this on exactly as it arrived,
 * lvalue or rvalue". Getting forward wrong is the difference between a
 * container that moves an element into place and one that copies it, and
 * nothing about the program says which happened.
 */

#include <type_traits>
#include <cstddef>

namespace std {

template <class T>
constexpr remove_reference_t<T> &&move(T &&t) noexcept {
    return static_cast<remove_reference_t<T> &&>(t);
}

template <class T>
constexpr T &&forward(remove_reference_t<T> &t) noexcept {
    return static_cast<T &&>(t);
}

template <class T>
constexpr T &&forward(remove_reference_t<T> &&t) noexcept {
    static_assert(!is_lvalue_reference<T>::value,
                  "forward must not turn an rvalue into an lvalue reference");
    return static_cast<T &&>(t);
}

/* Move if that is safe, copy otherwise.
 *
 * "Safe" means the move constructor cannot fail. A container relocating
 * its elements into a new allocation must be able to leave the old one
 * intact if anything goes wrong, and it cannot do that halfway through a
 * sequence of moves -- so it copies unless the move is noexcept. With
 * exceptions off nothing can fail, which makes this always a move here;
 * it is written properly anyway, because the condition is what ported
 * code's own types are annotated for. */
template <class T>
constexpr conditional_t<!is_nothrow_move_constructible<T>::value &&
                            is_copy_constructible<T>::value,
                        const T &, T &&>
move_if_noexcept(T &t) noexcept {
    return std::move(t);
}

template <class T>
constexpr void swap(T &a, T &b) noexcept {
    /* std::move rather than move, qualified. An unqualified call here is
     * found by argument-dependent lookup, so a type in another namespace
     * that happens to declare its own `move` would have that one chosen
     * instead -- silently, and only for that type. */
    T tmp = std::move(a);
    a = std::move(b);
    b = std::move(tmp);
}

template <class T, size_t N>
constexpr void swap(T (&a)[N], T (&b)[N]) noexcept {
    for (size_t i = 0; i < N; i++) std::swap(a[i], b[i]);
}

template <class T, class U = T>
constexpr T exchange(T &obj, U &&next) {
    T old = std::move(obj);
    obj = std::forward<U>(next);
    return old;
}

/* ---- pair ---- */

template <class T1, class T2>
struct pair {
    using first_type  = T1;
    using second_type = T2;

    T1 first;
    T2 second;

    constexpr pair() : first(), second() {}
    constexpr pair(const T1 &a, const T2 &b) : first(a), second(b) {}

    template <class U1, class U2>
    constexpr pair(U1 &&a, U2 &&b)
        : first(std::forward<U1>(a)), second(std::forward<U2>(b)) {}

    template <class U1, class U2>
    constexpr pair(const pair<U1, U2> &p) : first(p.first), second(p.second) {}

    constexpr pair(const pair &) = default;
    constexpr pair(pair &&) = default;
    constexpr pair &operator=(const pair &) = default;
    constexpr pair &operator=(pair &&) = default;

    constexpr void swap(pair &o) {
        std::swap(first, o.first);
        std::swap(second, o.second);
    }
};

template <class T1, class T2>
constexpr bool operator==(const pair<T1, T2> &a, const pair<T1, T2> &b) {
    return a.first == b.first && a.second == b.second;
}
template <class T1, class T2>
constexpr bool operator!=(const pair<T1, T2> &a, const pair<T1, T2> &b) {
    return !(a == b);
}
template <class T1, class T2>
constexpr bool operator<(const pair<T1, T2> &a, const pair<T1, T2> &b) {
    if (a.first < b.first) return true;
    if (b.first < a.first) return false;
    return a.second < b.second;
}

template <class T1, class T2>
constexpr pair<decay_t<T1>, decay_t<T2>> make_pair(T1 &&a, T2 &&b) {
    return pair<decay_t<T1>, decay_t<T2>>(std::forward<T1>(a),
                                          std::forward<T2>(b));
}

/* ---- a compile-time list of indices ----
 *
 * The tool for turning a parameter pack into 0, 1, 2, ... so that a
 * template can index into one. <variant> is what needs it here: visiting
 * means building a table with one entry per alternative, and the entries
 * have to be generated by their position.
 *
 * make_index_sequence uses the compiler's own builtin rather than the
 * textbook recursive doubling. The recursion instantiates a class per
 * step and is famously the slowest thing in a standard library; every
 * implementation switched to the builtin as soon as compilers offered
 * one.
 */
template <class T, T... Ints>
struct integer_sequence {
    using value_type = T;
    static constexpr size_t size() noexcept { return sizeof...(Ints); }
};

template <size_t... Ints>
using index_sequence = integer_sequence<size_t, Ints...>;

/* The two compilers spell their builtin differently — clang generates
 * the whole class, GCC generates the pack — so both are named. Neither
 * is optional: the portable recursive form is the one that made this
 * header the slowest in the library. */
#if defined(__clang__)
template <class T, T N>
using make_integer_sequence = __make_integer_seq<integer_sequence, T, N>;
#else
template <class T, T N>
using make_integer_sequence = integer_sequence<T, __integer_pack(N)...>;
#endif

template <size_t N>
using make_index_sequence = make_integer_sequence<size_t, N>;

template <class... T>
using index_sequence_for = make_index_sequence<sizeof...(T)>;

/* Tags for the two idioms that need one. in_place tells a constructor to
 * build its contents from the arguments rather than copy an object;
 * piecewise_construct does the same for both halves of a pair. */
struct in_place_t { explicit in_place_t() = default; };
inline constexpr in_place_t in_place{};

template <class T> struct in_place_type_t { explicit in_place_type_t() = default; };
template <class T> inline constexpr in_place_type_t<T> in_place_type{};

/* The index form, which <variant> needs to name an alternative that two
 * of its members share a type with — `variant<int, int>` is legal, and
 * in_place_type cannot say which of the two is meant. */
template <size_t I> struct in_place_index_t { explicit in_place_index_t() = default; };
template <size_t I> inline constexpr in_place_index_t<I> in_place_index{};

struct piecewise_construct_t { explicit piecewise_construct_t() = default; };
inline constexpr piecewise_construct_t piecewise_construct{};

}  // namespace std

#endif
