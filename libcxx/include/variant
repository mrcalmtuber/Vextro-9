// -*- C++ -*-
#ifndef _VXCXX_VARIANT
#define _VXCXX_VARIANT

/*
 * <variant> — a union that knows which member is live.
 *
 * ============================================================
 *  WHAT IT REPLACES
 * ============================================================
 *
 * A struct holding a union and an enum, and the discipline of never
 * reading the wrong member. That discipline is not enforceable by
 * review: the failure is silent, produces a plausible value, and appears
 * a long way from the line that caused it. Here the index and the union
 * are one object, every access checks, and a wrong access stops the
 * program at the point it is made.
 *
 * ============================================================
 *  HOW THE DISPATCH WORKS
 * ============================================================
 *
 * The index is a run-time value and the alternatives are compile-time
 * types, so everything that acts on "whichever one is live" — destroy,
 * copy, move, visit — is a table of function pointers with one entry per
 * alternative, generated by index_sequence and indexed by the live one.
 *
 * The tables are `static constexpr`, so each is emitted once and the
 * dispatch is a load and an indirect call rather than a chain of
 * comparisons. That is what makes visiting a variant of ten alternatives
 * cost the same as visiting one of two.
 *
 * ============================================================
 *  valueless_by_exception() IS ALWAYS FALSE, AND THAT IS EXACT
 * ============================================================
 *
 * The valueless state exists for one situation: a variant is being
 * assigned a new alternative, the old one has been destroyed, and the
 * new one's constructor *throws*. The variant then holds nothing, and
 * the standard invented the state rather than leave it undefined.
 *
 * This runtime is built with -fno-exceptions. Nothing can throw, so the
 * window the state exists to describe cannot occur, so the function
 * answers false — not as a simplification but as the truth on this
 * target. It is here because ported code checks it, and code that checks
 * it will take the correct branch.
 *
 * ============================================================
 *  WHAT IS NOT HERE
 * ============================================================
 *
 *   Multi-variant visit. `visit(f, a, b)` needs a table with one entry
 *   per *combination*, and the machinery to build an N-dimensional table
 *   is several times the size of everything else in this header. Single
 *   -variant visit is what gets used; the two-variant form is absent
 *   rather than wrong.
 *
 *   Full constexpr. The alternatives live in a byte buffer that is
 *   placement-new'd into, and that is not a constant expression. A
 *   conforming implementation uses a recursive union to be usable at
 *   compile time; nothing here needs a variant at compile time.
 *
 *   The converting constructor's exact overload resolution. The standard
 *   builds an imaginary overload set and applies the narrowing rules to
 *   it. This takes an exact match on the decayed type when there is one,
 *   and otherwise the unique alternative the argument converts to —
 *   which agrees with the standard for every unambiguous case and
 *   refuses to compile where it does not. in_place_index is how a caller
 *   says which one they meant.
 */

#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <new>
#include <type_traits>
#include <utility>
#include <initializer_list>

namespace std {

template <class... Types> class variant;

/* The empty alternative, for a variant that has to be able to hold
 * nothing in particular — usually as its first, so that it is default
 * constructible when the real alternatives are not. */
struct monostate {};

constexpr bool operator==(monostate, monostate) noexcept { return true; }
constexpr bool operator!=(monostate, monostate) noexcept { return false; }
constexpr bool operator<(monostate, monostate) noexcept  { return false; }

inline constexpr size_t variant_npos = static_cast<size_t>(-1);

/* ---- how many, and which ---- */

template <class V> struct variant_size;
template <class... T>
struct variant_size<variant<T...>>
    : integral_constant<size_t, sizeof...(T)> {};
template <class V> struct variant_size<const V> : variant_size<V> {};
template <class V> inline constexpr size_t variant_size_v = variant_size<V>::value;

template <size_t I, class V> struct variant_alternative;

template <size_t I, class Head, class... Tail>
struct variant_alternative<I, variant<Head, Tail...>>
    : variant_alternative<I - 1, variant<Tail...>> {};

template <class Head, class... Tail>
struct variant_alternative<0, variant<Head, Tail...>> { using type = Head; };

template <size_t I, class V>
struct variant_alternative<I, const V> {
    using type = const typename variant_alternative<I, V>::type;
};

template <size_t I, class V>
using variant_alternative_t = typename variant_alternative<I, V>::type;

namespace __vx {

/* Where T sits in the pack, or variant_npos. Not an error when absent:
 * the converting constructor asks this first and falls back to looking
 * for a unique conversion. */
template <class T, class... Ts> struct type_index_of;

template <class T> struct type_index_of<T>
    : integral_constant<size_t, variant_npos> {};

template <class T, class... Rest>
struct type_index_of<T, T, Rest...> : integral_constant<size_t, 0> {};

template <class T, class Head, class... Rest>
struct type_index_of<T, Head, Rest...>
    : integral_constant<size_t,
          type_index_of<T, Rest...>::value == variant_npos
              ? variant_npos
              : 1 + type_index_of<T, Rest...>::value> {};

/* How many alternatives T converts to, and the index of the last one.
 * Together they answer "is there exactly one, and which". */
template <class T, class... Ts>
constexpr size_t convertible_count() {
    size_t n = 0;
    const bool bits[] = { is_convertible<T, Ts>::value... };
    for (size_t i = 0; i < sizeof...(Ts); i++) if (bits[i]) n++;
    return n;
}

template <class T, class... Ts>
constexpr size_t convertible_index() {
    const bool bits[] = { is_convertible<T, Ts>::value... };
    for (size_t i = 0; i < sizeof...(Ts); i++) if (bits[i]) return i;
    return variant_npos;
}

/* The alternative a value of type T selects. Exact match wins; failing
 * that, a conversion, and only when exactly one alternative accepts it. */
template <class T, class... Ts>
constexpr size_t select_alternative() {
    constexpr size_t exact = type_index_of<decay_t<T>, Ts...>::value;
    if constexpr (exact != variant_npos) return exact;
    else if constexpr (convertible_count<T, Ts...>() == 1)
        return convertible_index<T, Ts...>();
    else return variant_npos;
}

constexpr size_t max_of(std::initializer_list<size_t> vs) {
    size_t m = 1;
    for (size_t v : vs) if (v > m) m = v;
    return m;
}

[[noreturn]] inline void bad_access(const char *what) {
    fputs_stream("libcxx: ", stderr);
    fputs_stream(what, stderr);
    fputs_stream("\n", stderr);
    abort();
}

}  // namespace __vx

template <class... Types>
class variant {
    static_assert(sizeof...(Types) > 0,
                  "a variant must have at least one alternative");

    static constexpr size_t N = sizeof...(Types);
    static constexpr size_t buf_size  = __vx::max_of({ sizeof(Types)... });
    static constexpr size_t buf_align = __vx::max_of({ alignof(Types)... });

    alignas(buf_align) unsigned char buf_[buf_size];
    size_t idx_;

    template <size_t I> using alt_t = variant_alternative_t<I, variant>;

    void       *raw()       { return static_cast<void *>(buf_); }
    const void *raw() const { return static_cast<const void *>(buf_); }

    /* ---- the dispatch tables ----
     *
     * One entry per alternative, generated by position. Each is
     * `static constexpr`, so it is a read-only array the linker emits
     * once and the call is an indirect jump rather than a switch. */

    template <size_t I> static void destroy_one(void *p) {
        static_cast<alt_t<I> *>(p)->~alt_t<I>();
    }
    template <size_t... Is>
    static void destroy_dispatch(index_sequence<Is...>, size_t i, void *p) {
        using fn = void (*)(void *);
        static constexpr fn table[] = { &destroy_one<Is>... };
        table[i](p);
    }

    template <size_t I> static void copy_one(void *dst, const void *src) {
        ::new (dst) alt_t<I>(*static_cast<const alt_t<I> *>(src));
    }
    template <size_t... Is>
    static void copy_dispatch(index_sequence<Is...>, size_t i,
                              void *dst, const void *src) {
        using fn = void (*)(void *, const void *);
        static constexpr fn table[] = { &copy_one<Is>... };
        table[i](dst, src);
    }

    template <size_t I> static void move_one(void *dst, void *src) {
        ::new (dst) alt_t<I>(std::move(*static_cast<alt_t<I> *>(src)));
    }
    template <size_t... Is>
    static void move_dispatch(index_sequence<Is...>, size_t i,
                              void *dst, void *src) {
        using fn = void (*)(void *, void *);
        static constexpr fn table[] = { &move_one<Is>... };
        table[i](dst, src);
    }

    template <size_t I> static bool equal_one(const void *a, const void *b) {
        return *static_cast<const alt_t<I> *>(a) ==
               *static_cast<const alt_t<I> *>(b);
    }
    template <size_t... Is>
    static bool equal_dispatch(index_sequence<Is...>, size_t i,
                               const void *a, const void *b) {
        using fn = bool (*)(const void *, const void *);
        static constexpr fn table[] = { &equal_one<Is>... };
        return table[i](a, b);
    }

    template <size_t I> static bool less_one(const void *a, const void *b) {
        return *static_cast<const alt_t<I> *>(a) <
               *static_cast<const alt_t<I> *>(b);
    }
    template <size_t... Is>
    static bool less_dispatch(index_sequence<Is...>, size_t i,
                              const void *a, const void *b) {
        using fn = bool (*)(const void *, const void *);
        static constexpr fn table[] = { &less_one<Is>... };
        return table[i](a, b);
    }

    void destroy_current() {
        destroy_dispatch(make_index_sequence<N>{}, idx_, raw());
    }

public:
    /* The first alternative, default-constructed — which is why a
     * variant whose first alternative has no default constructor is not
     * default constructible, and why monostate is usually first. */
    variant() : idx_(0) {
        static_assert(is_default_constructible<alt_t<0>>::value,
                      "the first alternative must be default constructible");
        ::new (raw()) alt_t<0>();
    }

    variant(const variant &o) : idx_(o.idx_) {
        copy_dispatch(make_index_sequence<N>{}, idx_, raw(), o.raw());
    }

    variant(variant &&o) : idx_(o.idx_) {
        move_dispatch(make_index_sequence<N>{}, idx_, raw(), o.raw());
    }

    /* From a value. See the head of this file for how the alternative is
     * chosen and where that differs from the standard's own rule. */
    template <class T,
              class = enable_if_t<
                  !is_same<decay_t<T>, variant>::value &&
                  __vx::select_alternative<T, Types...>() != variant_npos>>
    variant(T &&v) : idx_(__vx::select_alternative<T, Types...>()) {
        using Alt = alt_t<__vx::select_alternative<T, Types...>()>;
        ::new (raw()) Alt(std::forward<T>(v));
    }

    template <size_t I, class... A>
    explicit variant(in_place_index_t<I>, A &&...args) : idx_(I) {
        static_assert(I < N, "no such alternative");
        ::new (raw()) alt_t<I>(std::forward<A>(args)...);
    }

    template <class T, class... A>
    explicit variant(in_place_type_t<T>, A &&...args)
        : idx_(__vx::type_index_of<T, Types...>::value) {
        static_assert(__vx::type_index_of<T, Types...>::value != variant_npos,
                      "no such alternative");
        ::new (raw()) T(std::forward<A>(args)...);
    }

    ~variant() { destroy_current(); }

    variant &operator=(const variant &o) {
        if (this == &o) return *this;
        destroy_current();
        idx_ = o.idx_;
        copy_dispatch(make_index_sequence<N>{}, idx_, raw(), o.raw());
        return *this;
    }

    variant &operator=(variant &&o) {
        if (this == &o) return *this;
        destroy_current();
        idx_ = o.idx_;
        move_dispatch(make_index_sequence<N>{}, idx_, raw(), o.raw());
        return *this;
    }

    template <class T,
              class = enable_if_t<
                  !is_same<decay_t<T>, variant>::value &&
                  __vx::select_alternative<T, Types...>() != variant_npos>>
    variant &operator=(T &&v) {
        constexpr size_t I = __vx::select_alternative<T, Types...>();
        destroy_current();
        idx_ = I;
        ::new (raw()) alt_t<I>(std::forward<T>(v));
        return *this;
    }

    template <size_t I, class... A>
    alt_t<I> &emplace(A &&...args) {
        static_assert(I < N, "no such alternative");
        destroy_current();
        idx_ = I;
        return *::new (raw()) alt_t<I>(std::forward<A>(args)...);
    }

    template <class T, class... A>
    T &emplace(A &&...args) {
        constexpr size_t I = __vx::type_index_of<T, Types...>::value;
        static_assert(I != variant_npos, "no such alternative");
        return emplace<I>(std::forward<A>(args)...);
    }

    constexpr size_t index() const noexcept { return idx_; }

    /* Always false here. See the head of this file: the state exists to
     * describe a constructor that threw, and nothing on this target can
     * throw. */
    constexpr bool valueless_by_exception() const noexcept { return false; }

    void swap(variant &o) {
        variant tmp(std::move(*this));
        *this = std::move(o);
        o = std::move(tmp);
    }

    /* For get<> and visit, which are free functions and would otherwise
     * need a friend declaration each. */
    void       *__storage()       noexcept { return raw(); }
    const void *__storage() const noexcept { return raw(); }

    static bool __equal(size_t i, const void *a, const void *b) {
        return equal_dispatch(make_index_sequence<N>{}, i, a, b);
    }
    static bool __less(size_t i, const void *a, const void *b) {
        return less_dispatch(make_index_sequence<N>{}, i, a, b);
    }
};

/* ---- getting at the alternative ---- */

template <size_t I, class... Types>
variant_alternative_t<I, variant<Types...>> &get(variant<Types...> &v) {
    if (v.index() != I) __vx::bad_access("get<> on the wrong variant alternative");
    return *static_cast<variant_alternative_t<I, variant<Types...>> *>(
        v.__storage());
}

template <size_t I, class... Types>
const variant_alternative_t<I, variant<Types...>> &get(const variant<Types...> &v) {
    if (v.index() != I) __vx::bad_access("get<> on the wrong variant alternative");
    return *static_cast<const variant_alternative_t<I, variant<Types...>> *>(
        v.__storage());
}

template <size_t I, class... Types>
variant_alternative_t<I, variant<Types...>> &&get(variant<Types...> &&v) {
    return std::move(get<I>(v));
}

template <class T, class... Types>
T &get(variant<Types...> &v) {
    constexpr size_t I = __vx::type_index_of<T, Types...>::value;
    static_assert(I != variant_npos, "no such alternative");
    return get<I>(v);
}

template <class T, class... Types>
const T &get(const variant<Types...> &v) {
    constexpr size_t I = __vx::type_index_of<T, Types...>::value;
    static_assert(I != variant_npos, "no such alternative");
    return get<I>(v);
}

/* The checking form that answers rather than stops. This is what to
 * reach for when the alternative is genuinely in doubt; get<> is for
 * when it is not and being wrong is a bug. */
template <size_t I, class... Types>
variant_alternative_t<I, variant<Types...>> *get_if(variant<Types...> *v) {
    if (!v || v->index() != I) return nullptr;
    return static_cast<variant_alternative_t<I, variant<Types...>> *>(
        v->__storage());
}

template <size_t I, class... Types>
const variant_alternative_t<I, variant<Types...>> *get_if(const variant<Types...> *v) {
    if (!v || v->index() != I) return nullptr;
    return static_cast<const variant_alternative_t<I, variant<Types...>> *>(
        v->__storage());
}

template <class T, class... Types>
T *get_if(variant<Types...> *v) {
    constexpr size_t I = __vx::type_index_of<T, Types...>::value;
    static_assert(I != variant_npos, "no such alternative");
    return get_if<I>(v);
}

template <class T, class... Types>
const T *get_if(const variant<Types...> *v) {
    constexpr size_t I = __vx::type_index_of<T, Types...>::value;
    static_assert(I != variant_npos, "no such alternative");
    return get_if<I>(v);
}

template <class T, class... Types>
constexpr bool holds_alternative(const variant<Types...> &v) noexcept {
    constexpr size_t I = __vx::type_index_of<T, Types...>::value;
    static_assert(I != variant_npos, "no such alternative");
    return v.index() == I;
}

/* ---- visiting ----
 *
 * One variant. The visitor is called with whichever alternative is live,
 * through a table generated by position — so adding an alternative to
 * the variant makes any visitor that does not handle it fail to compile,
 * which is the property this is worth having for.
 */
namespace __vx {

template <class R, class Visitor, class V, size_t... Is>
R visit_dispatch(index_sequence<Is...>, Visitor &&vis, V &&var) {
    using fn = R (*)(Visitor &&, V &&);
    static constexpr fn table[] = {
        +[](Visitor &&f, V &&v) -> R {
            return static_cast<R>(std::forward<Visitor>(f)(
                get<Is>(std::forward<V>(v))));
        }...
    };
    return table[var.index()](std::forward<Visitor>(vis), std::forward<V>(var));
}

}  // namespace __vx

template <class Visitor, class... Types>
decltype(auto) visit(Visitor &&vis, variant<Types...> &var) {
    using R = decltype(std::forward<Visitor>(vis)(get<0>(var)));
    return __vx::visit_dispatch<R>(make_index_sequence<sizeof...(Types)>{},
                                   std::forward<Visitor>(vis), var);
}

template <class Visitor, class... Types>
decltype(auto) visit(Visitor &&vis, const variant<Types...> &var) {
    using R = decltype(std::forward<Visitor>(vis)(get<0>(var)));
    return __vx::visit_dispatch<R>(make_index_sequence<sizeof...(Types)>{},
                                   std::forward<Visitor>(vis), var);
}

/* ---- comparison ----
 *
 * Different alternatives compare by index, which is what the standard
 * says and is the only ordering available: there is no reason an int and
 * a string should be comparable, and the index gives a total order that
 * a sorted container can use.
 */
template <class... Types>
bool operator==(const variant<Types...> &a, const variant<Types...> &b) {
    if (a.index() != b.index()) return false;
    return variant<Types...>::__equal(a.index(), a.__storage(), b.__storage());
}

template <class... Types>
bool operator!=(const variant<Types...> &a, const variant<Types...> &b) {
    return !(a == b);
}

template <class... Types>
bool operator<(const variant<Types...> &a, const variant<Types...> &b) {
    if (a.index() != b.index()) return a.index() < b.index();
    return variant<Types...>::__less(a.index(), a.__storage(), b.__storage());
}

template <class... Types>
bool operator>(const variant<Types...> &a, const variant<Types...> &b) { return b < a; }
template <class... Types>
bool operator<=(const variant<Types...> &a, const variant<Types...> &b) { return !(b < a); }
template <class... Types>
bool operator>=(const variant<Types...> &a, const variant<Types...> &b) { return !(a < b); }

template <class... Types>
void swap(variant<Types...> &a, variant<Types...> &b) { a.swap(b); }

template <class T> struct hash;

template <>
struct hash<monostate> {
    size_t operator()(monostate) const noexcept { return 0x9E3779B9u; }
};

}  // namespace std

#endif
