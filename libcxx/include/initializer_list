// -*- C++ -*-
#ifndef _VXCXX_INITIALIZER_LIST
#define _VXCXX_INITIALIZER_LIST

/*
 * <initializer_list> — the one header whose contents the compiler
 * already knows.
 *
 * `std::vector<int> v = {1, 2, 3}` is compiled by GCC into a static
 * array of three ints and a call to a constructor taking a
 * std::initializer_list<int>, which it constructs *itself*, by writing a
 * pointer and a length into an object of this exact layout. The layout
 * is therefore not a choice:
 *
 *     const E *__begin;
 *     size_t   __len;
 *
 * in that order, with a private two-argument constructor the compiler
 * calls by position. Getting it wrong does not fail to compile. It
 * produces a list whose length is a pointer, and the failure is a
 * container that tries to allocate several petabytes.
 *
 * This is also why the header cannot simply be omitted and the type
 * declared where it is used: the compiler looks it up by name, in
 * namespace std, and reports "initializer_list was not declared" for a
 * braced list anywhere in the translation unit if it is not there.
 */

#include <cstddef>

namespace std {

template <class E>
class initializer_list {
public:
    using value_type      = E;
    using reference       = const E &;
    using const_reference = const E &;
    using size_type       = size_t;
    using iterator        = const E *;
    using const_iterator  = const E *;

    constexpr initializer_list() noexcept : __begin_(nullptr), __len_(0) {}

    constexpr size_t   size()  const noexcept { return __len_; }
    constexpr const E *begin() const noexcept { return __begin_; }
    constexpr const E *end()   const noexcept { return __begin_ + __len_; }

private:
    const E *__begin_;
    size_t   __len_;

    /* Only the compiler calls this. It is private precisely so that
     * nothing else can build a list whose pointer and length disagree. */
    constexpr initializer_list(const E *b, size_t n) noexcept
        : __begin_(b), __len_(n) {}
};

template <class E>
constexpr const E *begin(initializer_list<E> l) noexcept { return l.begin(); }

template <class E>
constexpr const E *end(initializer_list<E> l) noexcept { return l.end(); }

}  // namespace std

#endif
