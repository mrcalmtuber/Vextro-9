// -*- C++ -*-
#ifndef _VXCXX_MUTEX
#define _VXCXX_MUTEX

/*
 * <mutex> — over the pthreads in libc/pthread.c.
 *
 * Which are over SYS_CLONE and the kernel's futex, so a contended lock
 * here really does park the thread rather than spin: the whole chain
 * from lock_guard down to sched_block_on_locked is this system's own.
 *
 * ---- lock_guard is the point ----
 *
 * `m.lock()` and `m.unlock()` around a block is correct until somebody
 * adds an early return, and then it is a deadlock that appears months
 * later under load. lock_guard makes the unlock a destructor, which the
 * compiler emits on every path out of the scope including the ones
 * nobody thought about. It is one of the few abstractions that is
 * strictly free -- it compiles to the same two calls -- and strictly
 * safer.
 *
 * ---- and what is not here ----
 *
 * std::thread. Not an oversight: it wants to own a thread and join it in
 * its destructor, and its constructor has to move a callable of unknown
 * type into a new stack. libc/pthread.c does all of that already, and a
 * std::thread over it would be a hundred lines that adds nothing this
 * system needs today. See libcxx/README.md.
 */

#include <cstddef>
#include <utility>

extern "C" {
#include <pthread.h>
}

namespace std {

class mutex {
public:
    mutex() noexcept { pthread_mutex_init(&m_, nullptr); }
    ~mutex() { pthread_mutex_destroy(&m_); }

    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;

    void lock()   { pthread_mutex_lock(&m_); }
    void unlock() { pthread_mutex_unlock(&m_); }
    bool try_lock() { return pthread_mutex_trylock(&m_) == 0; }

    pthread_mutex_t *native_handle() noexcept { return &m_; }

private:
    pthread_mutex_t m_;
};

class recursive_mutex {
public:
    recursive_mutex() noexcept {
        pthread_mutexattr_t a;
        pthread_mutexattr_init(&a);
        pthread_mutexattr_settype(&a, PTHREAD_MUTEX_RECURSIVE);
        pthread_mutex_init(&m_, &a);
        pthread_mutexattr_destroy(&a);
    }
    ~recursive_mutex() { pthread_mutex_destroy(&m_); }

    recursive_mutex(const recursive_mutex &) = delete;
    recursive_mutex &operator=(const recursive_mutex &) = delete;

    void lock()   { pthread_mutex_lock(&m_); }
    void unlock() { pthread_mutex_unlock(&m_); }
    bool try_lock() { return pthread_mutex_trylock(&m_) == 0; }

private:
    pthread_mutex_t m_;
};

struct defer_lock_t  { explicit defer_lock_t() = default; };
struct try_to_lock_t { explicit try_to_lock_t() = default; };
struct adopt_lock_t  { explicit adopt_lock_t() = default; };
inline constexpr defer_lock_t  defer_lock{};
inline constexpr try_to_lock_t try_to_lock{};
inline constexpr adopt_lock_t  adopt_lock{};

template <class M>
class lock_guard {
public:
    using mutex_type = M;
    explicit lock_guard(M &m) : m_(m) { m_.lock(); }
    /* Already held by the caller: adopt it and unlock at the end of the
     * scope anyway. */
    lock_guard(M &m, adopt_lock_t) : m_(m) {}
    ~lock_guard() { m_.unlock(); }

    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;

private:
    M &m_;
};

template <class M>
class unique_lock {
public:
    using mutex_type = M;

    unique_lock() noexcept : m_(nullptr), owns_(false) {}
    explicit unique_lock(M &m) : m_(&m), owns_(true) { m_->lock(); }
    unique_lock(M &m, defer_lock_t) noexcept : m_(&m), owns_(false) {}
    unique_lock(M &m, try_to_lock_t) : m_(&m), owns_(m.try_lock()) {}
    unique_lock(M &m, adopt_lock_t) noexcept : m_(&m), owns_(true) {}

    unique_lock(unique_lock &&o) noexcept : m_(o.m_), owns_(o.owns_) {
        o.m_ = nullptr; o.owns_ = false;
    }
    unique_lock &operator=(unique_lock &&o) noexcept {
        if (this != &o) {
            if (owns_ && m_) m_->unlock();
            m_ = o.m_; owns_ = o.owns_;
            o.m_ = nullptr; o.owns_ = false;
        }
        return *this;
    }

    unique_lock(const unique_lock &) = delete;
    unique_lock &operator=(const unique_lock &) = delete;

    ~unique_lock() { if (owns_ && m_) m_->unlock(); }

    void lock()     { if (m_ && !owns_) { m_->lock(); owns_ = true; } }
    bool try_lock() { if (m_ && !owns_) owns_ = m_->try_lock(); return owns_; }
    void unlock()   { if (m_ && owns_) { m_->unlock(); owns_ = false; } }

    M   *release() noexcept { M *t = m_; m_ = nullptr; owns_ = false; return t; }
    M   *mutex() const noexcept { return m_; }
    bool owns_lock() const noexcept { return owns_; }
    explicit operator bool() const noexcept { return owns_; }

private:
    M   *m_;
    bool owns_;
};

/*
 * call_once.
 *
 * Not over pthread_once, which is the obvious choice and the wrong one:
 * it takes a function of no arguments and has nowhere to put a context,
 * so the callable would have to be reached through a file-scope pointer
 * — and two threads calling call_once on two different flags at the same
 * moment would each overwrite the other's.
 *
 * So the flag carries its own state and one mutex serialises the slow
 * path. The fast path, which is every call after the first, is an
 * acquiring load and a branch and never takes the lock at all. One mutex
 * shared by every flag in the program is enough because reaching the
 * slow path happens once per flag for the life of a process.
 */
struct once_flag {
    constexpr once_flag() noexcept : done_(0) {}
    once_flag(const once_flag &) = delete;
    once_flag &operator=(const once_flag &) = delete;
    int done_;
};

namespace __vx {
/* A function-local static, which is itself constructed exactly once by
 * the guard machinery in libcxx/src/cxa.cpp -- so this is call_once
 * standing on the compiler's own version of the same idea. */
inline mutex &once_mutex() {
    static mutex m;
    return m;
}
}

template <class F, class... A>
void call_once(once_flag &flag, F &&f, A &&...args) {
    if (__atomic_load_n(&flag.done_, __ATOMIC_ACQUIRE)) return;

    lock_guard<mutex> held(__vx::once_mutex());
    /* Re-tested under the lock: the winner of the race to get here is
     * not necessarily the first to have looked. */
    if (__atomic_load_n(&flag.done_, __ATOMIC_RELAXED)) return;

    std::forward<F>(f)(std::forward<A>(args)...);
    __atomic_store_n(&flag.done_, 1, __ATOMIC_RELEASE);
}

}  // namespace std

#endif
