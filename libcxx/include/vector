// -*- C++ -*-
#ifndef _VXCXX_VECTOR
#define _VXCXX_VECTOR

/*
 * <vector> — a contiguous array that grows.
 *
 * ============================================================
 *  GROWTH IS GEOMETRIC, AND THAT IS THE WHOLE INTERFACE
 * ============================================================
 *
 * push_back is documented as *amortised* constant time, and the word
 * amortised is load-bearing: an individual push that has to reallocate
 * copies everything. What makes the average constant is that the
 * capacity doubles rather than growing by a fixed amount — n pushes then
 * cost n copies in total rather than n²/2.
 *
 * Doubling, not 1.5×. The argument for 1.5 is that a sequence of
 * doublings can never reuse the memory it has already freed, whereas
 * 1.5 eventually can; the argument against it here is that this
 * allocator is a first-fit free list and coalesces, so it reuses freed
 * space anyway, and doubling is one fewer reallocation.
 *
 * ============================================================
 *  WHAT INVALIDATES AN ITERATOR
 * ============================================================
 *
 * Any reallocation, which is any insertion past the capacity. That is
 * the single most common way to write a bug with this container:
 *
 *     for (auto it = v.begin(); it != v.end(); ++it)
 *         if (*it == x) v.push_back(y);          // `it` may now dangle
 *
 * There is no check for it. A checked implementation would cost a
 * generation counter per iterator and per container, and this library
 * would rather be the same shape as the one code is ported from.
 *
 * ============================================================
 *  at() STOPS THE PROGRAM
 * ============================================================
 *
 * The standard says it throws std::out_of_range. There are no exceptions
 * here, so it prints which index was out of range and how large the
 * vector was, and aborts. That is the honest reading of "the caller
 * asked for an element that does not exist": returning a reference to
 * nothing would corrupt whatever is nearby, and at() is precisely the
 * accessor a caller chose *because* it wanted the check.
 *
 * operator[] does not check, exactly as it does not anywhere else.
 */

#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <type_traits>
#include <utility>
#include <new>
#include <iterator>
#include <algorithm>
#include <initializer_list>
#include <memory>

namespace std {

template <class T, class Alloc = allocator<T>>
class vector {
public:
    using value_type      = T;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using reference       = T &;
    using const_reference = const T &;
    using pointer         = T *;
    using const_pointer   = const T *;
    using iterator        = T *;
    using const_iterator  = const T *;
    using reverse_iterator       = std::reverse_iterator<T *>;
    using const_reverse_iterator = std::reverse_iterator<const T *>;
    using allocator_type  = Alloc;

    vector() noexcept : d_(nullptr), n_(0), cap_(0) {}

    explicit vector(size_type n) : d_(nullptr), n_(0), cap_(0) {
        resize(n);
    }

    vector(size_type n, const T &v) : d_(nullptr), n_(0), cap_(0) {
        reserve(n);
        for (size_type i = 0; i < n; i++) ::new ((void *)(d_ + i)) T(v);
        n_ = n;
    }

    template <class I, class = enable_if_t<
        !is_integral<I>::value>>
    vector(I first, I last) : d_(nullptr), n_(0), cap_(0) {
        for (; first != last; ++first) push_back(*first);
    }

    vector(initializer_list<T> l) : d_(nullptr), n_(0), cap_(0) {
        reserve(l.size());
        for (const T *p = l.begin(); p != l.end(); ++p)
            ::new ((void *)(d_ + n_++)) T(*p);
    }

    vector(const vector &o) : d_(nullptr), n_(0), cap_(0) {
        reserve(o.n_);
        for (size_type i = 0; i < o.n_; i++) ::new ((void *)(d_ + i)) T(o.d_[i]);
        n_ = o.n_;
    }

    vector(vector &&o) noexcept : d_(o.d_), n_(o.n_), cap_(o.cap_) {
        o.d_ = nullptr; o.n_ = 0; o.cap_ = 0;
    }

    ~vector() { destroy_all(); ::operator delete(d_); }

    vector &operator=(const vector &o) {
        if (this == &o) return *this;
        clear();
        reserve(o.n_);
        for (size_type i = 0; i < o.n_; i++) ::new ((void *)(d_ + i)) T(o.d_[i]);
        n_ = o.n_;
        return *this;
    }

    vector &operator=(vector &&o) noexcept {
        if (this == &o) return *this;
        destroy_all();
        ::operator delete(d_);
        d_ = o.d_; n_ = o.n_; cap_ = o.cap_;
        o.d_ = nullptr; o.n_ = 0; o.cap_ = 0;
        return *this;
    }

    vector &operator=(initializer_list<T> l) {
        clear();
        reserve(l.size());
        for (const T *p = l.begin(); p != l.end(); ++p)
            ::new ((void *)(d_ + n_++)) T(*p);
        return *this;
    }

    void assign(size_type n, const T &v) {
        clear();
        reserve(n);
        for (size_type i = 0; i < n; i++) ::new ((void *)(d_ + i)) T(v);
        n_ = n;
    }

    template <class I, class = enable_if_t<!is_integral<I>::value>>
    void assign(I first, I last) {
        clear();
        for (; first != last; ++first) push_back(*first);
    }

    /* ---- access ---- */

    reference       operator[](size_type i)       { return d_[i]; }
    const_reference operator[](size_type i) const { return d_[i]; }

    reference at(size_type i) {
        if (i >= n_) out_of_range(i);
        return d_[i];
    }
    const_reference at(size_type i) const {
        if (i >= n_) out_of_range(i);
        return d_[i];
    }

    reference       front()       { return d_[0]; }
    const_reference front() const { return d_[0]; }
    reference       back()        { return d_[n_ - 1]; }
    const_reference back()  const { return d_[n_ - 1]; }

    T       *data()       noexcept { return d_; }
    const T *data() const noexcept { return d_; }

    /* ---- size ---- */

    bool      empty()    const noexcept { return n_ == 0; }
    size_type size()     const noexcept { return n_; }
    size_type capacity() const noexcept { return cap_; }
    size_type max_size() const noexcept { return (size_type)-1 / sizeof(T); }

    void reserve(size_type want) {
        if (want <= cap_) return;
        regrow(want);
    }

    void shrink_to_fit() {
        if (n_ == cap_) return;
        if (n_ == 0) { ::operator delete(d_); d_ = nullptr; cap_ = 0; return; }
        regrow(n_);
    }

    void resize(size_type want) {
        if (want < n_) {
            for (size_type i = want; i < n_; i++) d_[i].~T();
        } else if (want > n_) {
            reserve(want);
            for (size_type i = n_; i < want; i++) ::new ((void *)(d_ + i)) T();
        }
        n_ = want;
    }

    void resize(size_type want, const T &v) {
        if (want < n_) {
            for (size_type i = want; i < n_; i++) d_[i].~T();
        } else if (want > n_) {
            reserve(want);
            for (size_type i = n_; i < want; i++) ::new ((void *)(d_ + i)) T(v);
        }
        n_ = want;
    }

    /* ---- growing ---- */

    void push_back(const T &v) {
        if (n_ == cap_) grow_one(&v);
        else ::new ((void *)(d_ + n_)) T(v);
        n_++;
    }

    void push_back(T &&v) {
        if (n_ == cap_) {
            /* The same hazard the const& form has, in its other shape:
             * v.push_back(std::move(v[0])) names storage regrow is about
             * to free. */
            T copy(std::move(v));
            regrow(next_capacity());
            ::new ((void *)(d_ + n_)) T(std::move(copy));
        } else {
            ::new ((void *)(d_ + n_)) T(std::move(v));
        }
        n_++;
    }

    template <class... A>
    reference emplace_back(A &&...args) {
        if (n_ == cap_) regrow(next_capacity());
        ::new ((void *)(d_ + n_)) T(std::forward<A>(args)...);
        return d_[n_++];
    }

    void pop_back() { if (n_) d_[--n_].~T(); }

    /*
     * ---- both of these copy first, always ----
     *
     * The argument may be an element of this very vector:
     *
     *     v.insert(v.begin(), v[3]);
     *
     * is legal and the standard requires it to work. Two separate things
     * go wrong without the copy, and the first one is the one that was
     * actually caught:
     *
     *   Even without reallocating, the shuffle in insert_at moves the
     *   tail up by one -- which overwrites the element the reference
     *   points at, so the assignment that follows reads a value that has
     *   just been replaced by its neighbour. The failure is silent and
     *   produces a plausible answer: the wrong element, duplicated.
     *
     *   And when it does reallocate, the reference points into storage
     *   that has just been freed.
     *
     * A copy to a local before anything moves handles both. It costs one
     * move on the common path, which is what every implementation pays
     * for the same reason.
     */
    iterator insert(const_iterator pos, const T &v) {
        const size_type at = (size_type)(pos - d_);
        T copy(v);
        if (n_ == cap_) regrow(next_capacity());
        return insert_at(at, std::move(copy));
    }

    iterator insert(const_iterator pos, T &&v) {
        const size_type at = (size_type)(pos - d_);
        T copy(std::move(v));
        if (n_ == cap_) regrow(next_capacity());
        return insert_at(at, std::move(copy));
    }

    /* A range, which unlike the two above may *not* come from this same
     * vector: the standard says so, and making it safe would mean
     * copying the whole range to one side first. Ranges from elsewhere
     * are what this is for. */
    template <class I, class = enable_if_t<!is_integral<I>::value>>
    iterator insert(const_iterator pos, I first, I last) {
        const size_type at = (size_type)(pos - d_);
        size_type k = 0;
        for (I i = first; i != last; ++i) k++;
        if (!k) return d_ + at;

        reserve(n_ + k);
        /* Backwards, so that a source range overlapping the destination
         * is read before it is overwritten. */
        for (size_type i = n_; i > at; i--) {
            if (i - 1 + k >= n_) ::new ((void *)(d_ + i - 1 + k)) T(std::move(d_[i - 1]));
            else d_[i - 1 + k] = std::move(d_[i - 1]);
        }
        size_type w = at;
        for (I i = first; i != last; ++i, ++w) {
            if (w >= n_) ::new ((void *)(d_ + w)) T(*i);
            else d_[w] = *i;
        }
        n_ += k;
        return d_ + at;
    }

    iterator erase(const_iterator pos) {
        const size_type at = (size_type)(pos - d_);
        for (size_type i = at; i + 1 < n_; i++) d_[i] = std::move(d_[i + 1]);
        d_[--n_].~T();
        return d_ + at;
    }

    iterator erase(const_iterator first, const_iterator last) {
        const size_type a = (size_type)(first - d_);
        const size_type b = (size_type)(last - d_);
        if (b <= a) return d_ + a;
        const size_type k = b - a;
        for (size_type i = a; i + k < n_; i++) d_[i] = std::move(d_[i + k]);
        for (size_type i = n_ - k; i < n_; i++) d_[i].~T();
        n_ -= k;
        return d_ + a;
    }

    void clear() noexcept { destroy_all(); n_ = 0; }

    void swap(vector &o) noexcept {
        std::swap(d_, o.d_); std::swap(n_, o.n_); std::swap(cap_, o.cap_);
    }

    /* ---- iteration ---- */

    iterator       begin()       noexcept { return d_; }
    const_iterator begin() const noexcept { return d_; }
    iterator       end()         noexcept { return d_ + n_; }
    const_iterator end()   const noexcept { return d_ + n_; }
    const_iterator cbegin() const noexcept { return d_; }
    const_iterator cend()   const noexcept { return d_ + n_; }

    reverse_iterator rbegin() noexcept { return reverse_iterator(d_ + n_); }
    reverse_iterator rend()   noexcept { return reverse_iterator(d_); }
    const_reverse_iterator rbegin() const noexcept {
        return const_reverse_iterator(d_ + n_);
    }
    const_reverse_iterator rend() const noexcept {
        return const_reverse_iterator(d_);
    }

private:
    T        *d_;
    size_type n_;
    size_type cap_;

    size_type next_capacity() const { return cap_ ? cap_ * 2 : 4; }

    /* The shuffle, with the capacity already sufficient. One past the
     * end is *constructed*, then the tail is moved up by *assignment*,
     * because everything from `at` onwards already holds a live object.
     * Constructing over a live object, or assigning into raw storage,
     * are the two ways to get this wrong and both are silent. */
    iterator insert_at(size_type at, T &&v) {
        if (at < n_) {
            ::new ((void *)(d_ + n_)) T(std::move(d_[n_ - 1]));
            for (size_type i = n_ - 1; i > at; i--) d_[i] = std::move(d_[i - 1]);
            d_[at] = std::move(v);
        } else {
            ::new ((void *)(d_ + n_)) T(std::move(v));
        }
        n_++;
        return d_ + at;
    }

    [[noreturn]] void out_of_range(size_type i) const {
        char msg[128];
        snprintf(msg, sizeof(msg),
                 "vector::at(%lu) on a vector of %lu\n",
                 (unsigned long)i, (unsigned long)n_);
        fputs_stream(msg, stderr);
        abort();
    }

    void destroy_all() noexcept {
        if constexpr (!is_trivially_destructible<T>::value)
            for (size_type i = 0; i < n_; i++) d_[i].~T();
    }

    /*
     * The one place elements move between allocations.
     *
     * Trivially copyable types go through memcpy, which for a vector of
     * ints is the difference between a loop and one instruction sequence
     * the processor can stream. Everything else is moved one at a time
     * and the old one destroyed, in that order, because a type whose
     * move constructor reads the source needs the source to still exist.
     */
    void regrow(size_type want) {
        if (want < 4) want = 4;
        T *fresh = (T *)::operator new(want * sizeof(T));
        if constexpr (is_trivially_copyable<T>::value) {
            if (n_) __builtin_memcpy(fresh, d_, n_ * sizeof(T));
        } else {
            for (size_type i = 0; i < n_; i++) {
                ::new ((void *)(fresh + i)) T(std::move(d_[i]));
                d_[i].~T();
            }
        }
        ::operator delete(d_);
        d_ = fresh;
        cap_ = want;
    }

    /*
     * push_back of an lvalue that may live inside this vector.
     *
     *     v.push_back(v[0]);
     *
     * is legal, and a naive implementation reallocates -- freeing the
     * storage `v[0]` is in -- and then copies from the freed memory. The
     * copy is made first, into a local, and only then does the vector
     * grow.
     */
    void grow_one(const T *v) {
        T copy(*v);
        regrow(next_capacity());
        ::new ((void *)(d_ + n_)) T(std::move(copy));
    }
};

template <class T, class A>
bool operator==(const vector<T, A> &a, const vector<T, A> &b) {
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); i++) if (!(a[i] == b[i])) return false;
    return true;
}

template <class T, class A>
bool operator!=(const vector<T, A> &a, const vector<T, A> &b) { return !(a == b); }

template <class T, class A>
bool operator<(const vector<T, A> &a, const vector<T, A> &b) {
    return lexicographical_compare(a.begin(), a.end(), b.begin(), b.end());
}

template <class T, class A>
void swap(vector<T, A> &a, vector<T, A> &b) noexcept { a.swap(b); }

}  // namespace std

#endif
