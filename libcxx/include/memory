namespace std {

template <class T>
constexpr T *addressof(T &r) noexcept { return __builtin_addressof(r); }

/* ---- default_delete ---- */

template <class T>
struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U, class = enable_if_t<is_convertible<U *, T *>::value>>
    default_delete(const default_delete<U> &) noexcept {}

    void operator()(T *p) const {
        /* The static assertion is the guard against the classic bug: a
         * unique_ptr to an incomplete type, destroyed where the type is
         * still incomplete, calls no destructor at all and does so
         * silently. sizeof forces the type to be complete here. */
        static_assert(sizeof(T) > 0, "cannot delete an incomplete type");
        delete p;
    }
};

template <class T>
struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;
    void operator()(T *p) const {
        static_assert(sizeof(T) > 0, "cannot delete an incomplete type");
        delete[] p;
    }
};

/* ---- unique_ptr ---- */

template <class T, class D = default_delete<T>>
class unique_ptr {
public:
    using pointer      = T *;
    using element_type = T;
    using deleter_type = D;

    constexpr unique_ptr() noexcept : p_(nullptr), d_() {}
    constexpr unique_ptr(nullptr_t) noexcept : p_(nullptr), d_() {}
    explicit unique_ptr(pointer p) noexcept : p_(p), d_() {}
    unique_ptr(pointer p, D d) noexcept : p_(p), d_(std::move(d)) {}

    unique_ptr(unique_ptr &&o) noexcept
        : p_(o.release()), d_(std::move(o.d_)) {}

    template <class U, class E,
              class = enable_if_t<is_convertible<U *, T *>::value>>
    unique_ptr(unique_ptr<U, E> &&o) noexcept : p_(o.release()), d_() {}

    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    ~unique_ptr() { if (p_) d_(p_); }

    unique_ptr &operator=(unique_ptr &&o) noexcept {
        if (this != &o) { reset(o.release()); d_ = std::move(o.d_); }
        return *this;
    }
    unique_ptr &operator=(nullptr_t) noexcept { reset(); return *this; }

    pointer release() noexcept { pointer t = p_; p_ = nullptr; return t; }

    void reset(pointer p = nullptr) noexcept {
        /* The old pointer is deleted *after* the member is overwritten,
         * because a destructor that reaches back into the object that
         * held it must not find it still pointing at itself. */
        pointer old = p_;
        p_ = p;
        if (old) d_(old);
    }

    void swap(unique_ptr &o) noexcept { std::swap(p_, o.p_); std::swap(d_, o.d_); }

    pointer get() const noexcept { return p_; }
    D &get_deleter() noexcept { return d_; }
    const D &get_deleter() const noexcept { return d_; }

    explicit operator bool() const noexcept { return p_ != nullptr; }
    T &operator*() const { return *p_; }
    pointer operator->() const noexcept { return p_; }

private:
    pointer p_;
    D       d_;
};

/* The array form, which differs in more than the deleter: it has
 * operator[] and does not have operator* or operator->, because a
 * pointer to an array is not a pointer to an object. */
template <class T, class D>
class unique_ptr<T[], D> {
public:
    using pointer      = T *;
    using element_type = T;

    constexpr unique_ptr() noexcept : p_(nullptr), d_() {}
    constexpr unique_ptr(nullptr_t) noexcept : p_(nullptr), d_() {}
    explicit unique_ptr(pointer p) noexcept : p_(p), d_() {}
    unique_ptr(unique_ptr &&o) noexcept : p_(o.release()), d_(std::move(o.d_)) {}
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (p_) d_(p_); }

    unique_ptr &operator=(unique_ptr &&o) noexcept {
        if (this != &o) { reset(o.release()); d_ = std::move(o.d_); }
        return *this;
    }

    pointer release() noexcept { pointer t = p_; p_ = nullptr; return t; }
    void reset(pointer p = nullptr) noexcept {
        pointer old = p_; p_ = p; if (old) d_(old);
    }
    void swap(unique_ptr &o) noexcept { std::swap(p_, o.p_); }

    pointer get() const noexcept { return p_; }
    explicit operator bool() const noexcept { return p_ != nullptr; }
    T &operator[](size_t i) const { return p_[i]; }

private:
    pointer p_;
    D       d_;
};

template <class T, class D>
bool operator==(const unique_ptr<T, D> &a, nullptr_t) noexcept { return !a; }
template <class T, class D>
bool operator!=(const unique_ptr<T, D> &a, nullptr_t) noexcept { return (bool)a; }
template <class T, class D, class U, class E>
bool operator==(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b) noexcept {
    return a.get() == b.get();
}
template <class T, class D, class U, class E>
bool operator!=(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b) noexcept {
    return a.get() != b.get();
}

namespace __vx {
template <class T> struct unique_kind      { using single = unique_ptr<T>; };
template <class T> struct unique_kind<T[]> { using array  = unique_ptr<T[]>; };
}

template <class T, class... A>
typename __vx::unique_kind<T>::single make_unique(A &&...args) {
    return unique_ptr<T>(new T(std::forward<A>(args)...));
}

template <class T>
typename __vx::unique_kind<T>::array make_unique(size_t n) {
    return unique_ptr<T>(new remove_extent_t<T>[n]());
}

/* ---- shared_ptr ---- */

namespace __vx {

/*
 * The control block.
 *
 * Two counts, and the distinction between them is the whole design.
 * `strong` is how many owners there are; when it reaches zero the object
 * is destroyed. `weak` is how many observers there are *plus one for the
 * owners collectively*; when it reaches zero the block itself is freed.
 *
 * The extra one is what makes the two independent: the last owner
 * destroys the object and then drops that one reference, so a weak_ptr
 * outliving the object keeps the block — and therefore the counts —
 * readable, which is what lets it answer "expired" rather than read
 * freed memory.
 */
struct sp_control {
    atomic<long> strong{1};
    atomic<long> weak{1};

    virtual ~sp_control() {}
    virtual void destroy_object() = 0;

    void retain() noexcept { strong.fetch_add(1, memory_order_relaxed); }

    void release() noexcept {
        /* Acquire on the way down so that everything every other owner
         * did before releasing happens-before the destructor. Without
         * it, the thread that destroys the object may not see writes
         * another owner made through it. */
        if (strong.fetch_sub(1, memory_order_acq_rel) == 1) {
            destroy_object();
            release_weak();
        }
    }

    void retain_weak() noexcept { weak.fetch_add(1, memory_order_relaxed); }

    void release_weak() noexcept {
        if (weak.fetch_sub(1, memory_order_acq_rel) == 1) delete this;
    }

    /* The one operation that cannot be a load followed by an increment:
     * between the two, the last owner could release and destroy the
     * object, and the increment would resurrect a count for something
     * that no longer exists. The compare-exchange makes it one step. */
    bool retain_if_alive() noexcept {
        long n = strong.load(memory_order_relaxed);
        for (;;) {
            if (n == 0) return false;
            if (strong.compare_exchange_weak(n, n + 1, memory_order_acq_rel,
                                             memory_order_relaxed))
                return true;
        }
    }
};

/* A block for a pointer somebody else allocated. */
template <class T, class D>
struct sp_ptr_control : sp_control {
    T *p;
    D  d;
    sp_ptr_control(T *ptr, D del) : p(ptr), d(std::move(del)) {}
    void destroy_object() override { if (p) d(p); p = nullptr; }
};

/* A block with the object inside it: one allocation for both, which is
 * what make_shared is for. */
template <class T>
struct sp_inline_control : sp_control {
    alignas(T) unsigned char storage[sizeof(T)];
    bool built = false;

    template <class... A>
    explicit sp_inline_control(A &&...args) {
        ::new ((void *)storage) T(std::forward<A>(args)...);
        built = true;
    }
    T *get() { return reinterpret_cast<T *>(storage); }
    void destroy_object() override {
        if (built) { get()->~T(); built = false; }
    }
};

}  // namespace __vx

template <class T> class weak_ptr;

template <class T>
class shared_ptr {
public:
    using element_type = T;

    constexpr shared_ptr() noexcept : p_(nullptr), c_(nullptr) {}
    constexpr shared_ptr(nullptr_t) noexcept : p_(nullptr), c_(nullptr) {}

    template <class U, class = enable_if_t<is_convertible<U *, T *>::value>>
    explicit shared_ptr(U *p)
        : p_(p), c_(p ? new __vx::sp_ptr_control<U, default_delete<U>>(
                            p, default_delete<U>())
                      : nullptr) {}

    template <class U, class D>
    shared_ptr(U *p, D d)
        : p_(p), c_(new __vx::sp_ptr_control<U, D>(p, std::move(d))) {}

    shared_ptr(const shared_ptr &o) noexcept : p_(o.p_), c_(o.c_) {
        if (c_) c_->retain();
    }

    template <class U, class = enable_if_t<is_convertible<U *, T *>::value>>
    shared_ptr(const shared_ptr<U> &o) noexcept
        : p_(o.get()), c_(o.__control()) {
        if (c_) c_->retain();
    }

    shared_ptr(shared_ptr &&o) noexcept : p_(o.p_), c_(o.c_) {
        o.p_ = nullptr; o.c_ = nullptr;
    }

    /* The aliasing constructor: shares another pointer's *ownership*
     * while pointing at something else -- a member of the owned object,
     * usually. Rare and impossible to write any other way. */
    template <class U>
    shared_ptr(const shared_ptr<U> &owner, T *p) noexcept
        : p_(p), c_(owner.__control()) {
        if (c_) c_->retain();
    }

    ~shared_ptr() { if (c_) c_->release(); }

    shared_ptr &operator=(const shared_ptr &o) noexcept {
        /* Retain before release: self-assignment must not destroy the
         * object between the two. */
        if (o.c_) o.c_->retain();
        if (c_) c_->release();
        p_ = o.p_; c_ = o.c_;
        return *this;
    }

    shared_ptr &operator=(shared_ptr &&o) noexcept {
        if (this != &o) {
            if (c_) c_->release();
            p_ = o.p_; c_ = o.c_;
            o.p_ = nullptr; o.c_ = nullptr;
        }
        return *this;
    }

    void reset() noexcept {
        if (c_) c_->release();
        p_ = nullptr; c_ = nullptr;
    }

    template <class U>
    void reset(U *p) { shared_ptr(p).swap(*this); }

    void swap(shared_ptr &o) noexcept { std::swap(p_, o.p_); std::swap(c_, o.c_); }

    T *get() const noexcept { return p_; }
    T &operator*() const noexcept { return *p_; }
    T *operator->() const noexcept { return p_; }
    explicit operator bool() const noexcept { return p_ != nullptr; }

    long use_count() const noexcept {
        return c_ ? c_->strong.load(memory_order_relaxed) : 0;
    }
    bool unique() const noexcept { return use_count() == 1; }

    /* Not part of the interface; the other smart pointers need it and a
     * friend declaration for each would be longer than the comment
     * saying not to call it. */
    __vx::sp_control *__control() const noexcept { return c_; }
    void __adopt(T *p, __vx::sp_control *c) noexcept { p_ = p; c_ = c; }

private:
    T                *p_;
    __vx::sp_control *c_;
};

template <class T, class U>
bool operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept {
    return a.get() == b.get();
}
template <class T, class U>
bool operator!=(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept {
    return a.get() != b.get();
}
template <class T>
bool operator==(const shared_ptr<T> &a, nullptr_t) noexcept { return !a; }
template <class T>
bool operator!=(const shared_ptr<T> &a, nullptr_t) noexcept { return (bool)a; }

template <class T, class... A>
shared_ptr<T> make_shared(A &&...args) {
    auto *c = new __vx::sp_inline_control<T>(std::forward<A>(args)...);
    shared_ptr<T> s;
    s.__adopt(c->get(), c);
    return s;
}

template <class T>
class weak_ptr {
public:
    constexpr weak_ptr() noexcept : p_(nullptr), c_(nullptr) {}

    weak_ptr(const shared_ptr<T> &s) noexcept
        : p_(s.get()), c_(s.__control()) {
        if (c_) c_->retain_weak();
    }
    weak_ptr(const weak_ptr &o) noexcept : p_(o.p_), c_(o.c_) {
        if (c_) c_->retain_weak();
    }
    weak_ptr(weak_ptr &&o) noexcept : p_(o.p_), c_(o.c_) {
        o.p_ = nullptr; o.c_ = nullptr;
    }
    ~weak_ptr() { if (c_) c_->release_weak(); }

    weak_ptr &operator=(const weak_ptr &o) noexcept {
        if (o.c_) o.c_->retain_weak();
        if (c_) c_->release_weak();
        p_ = o.p_; c_ = o.c_;
        return *this;
    }
    weak_ptr &operator=(const shared_ptr<T> &s) noexcept {
        weak_ptr(s).swap(*this);
        return *this;
    }

    void swap(weak_ptr &o) noexcept { std::swap(p_, o.p_); std::swap(c_, o.c_); }
    void reset() noexcept { if (c_) c_->release_weak(); p_ = nullptr; c_ = nullptr; }

    long use_count() const noexcept {
        return c_ ? c_->strong.load(memory_order_relaxed) : 0;
    }
    bool expired() const noexcept { return use_count() == 0; }

    /* The only safe way to get at the object: it either succeeds and
     * hands back an owner, or it fails. Checking expired() and then
     * building a shared_ptr would be two steps with a gap in between. */
    shared_ptr<T> lock() const noexcept {
        shared_ptr<T> s;
        if (c_ && c_->retain_if_alive()) s.__adopt(p_, c_);
        return s;
    }

private:
    T                *p_;
    __vx::sp_control *c_;
};

/* ---- raw memory ---- */

template <class T, class... A>
constexpr T *construct_at(T *p, A &&...args) {
    return ::new ((void *)p) T(std::forward<A>(args)...);
}

template <class T>
constexpr void destroy_at(T *p) { p->~T(); }

template <class I>
constexpr void destroy(I first, I last) {
    while (first != last) { destroy_at(addressof(*first)); ++first; }
}

template <class I, class O>
O uninitialized_copy(I first, I last, O out) {
    using T = typename iterator_traits<O>::value_type;
    while (first != last) { ::new ((void *)addressof(*out)) T(*first); ++first; ++out; }
    return out;
}

template <class I, class O>
O uninitialized_move(I first, I last, O out) {
    using T = typename iterator_traits<O>::value_type;
    while (first != last) {
        ::new ((void *)addressof(*out)) T(std::move(*first));
        ++first; ++out;
    }
    return out;
}

template <class I, class T>
void uninitialized_fill(I first, I last, const T &v) {
    using E = typename iterator_traits<I>::value_type;
    while (first != last) { ::new ((void *)addressof(*first)) E(v); ++first; }
}

/*
 * The default allocator.
 *
 * Present because containers are written against the interface and
 * ported code passes its own. The containers in this library do not use
 * it -- they call ::operator new directly, which is the same memory
 * through one fewer layer -- so this is here to be *named* and to work
 * when it is.
 */
template <class T>
struct allocator {
    using value_type      = T;
    using pointer         = T *;
    using const_pointer   = const T *;
    using reference       = T &;
    using const_reference = const T &;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;

    template <class U> struct rebind { using other = allocator<U>; };

    constexpr allocator() noexcept = default;
    template <class U> constexpr allocator(const allocator<U> &) noexcept {}

    [[nodiscard]] T *allocate(size_t n) {
        return (T *)::operator new(n * sizeof(T));
    }
    void deallocate(T *p, size_t) noexcept { ::operator delete(p); }

    template <class U, class... A> void construct(U *p, A &&...args) {
        ::new ((void *)p) U(std::forward<A>(args)...);
    }
    template <class U> void destroy(U *p) { p->~U(); }

    size_t max_size() const noexcept { return (size_t)-1 / sizeof(T); }
};

template <class T, class U>
constexpr bool operator==(const allocator<T> &, const allocator<U> &) noexcept {
    return true;
}
template <class T, class U>
constexpr bool operator!=(const allocator<T> &, const allocator<U> &) noexcept {
    return false;
}

