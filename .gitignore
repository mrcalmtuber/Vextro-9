# Build artifacts
build/

# Generated ISO (distributed via GitHub Releases)
os.iso

# ISO root populated at build time
iso_root/boot/
iso_root/EFI/


# Extracted limine source tree
limine-12.3.2/

# macOS metadata
.DS_Store
**/.DS_Store

# Claude session data
.claude/

# Generated FAT32 system disk (user data lives here)
disk.img

# .vx toolchain binaries and example images
vxfmt/vx_maker
vxfmt/vx_run
vxfmt/*.o
vxfmt/*.bin
vxfmt/*.elf
vxfmt/*.vx
assets/

# Fuzzer working directory: AFL's queue, crashes and stats are session
# state, not source. The seed corpus in vxfmt/fuzz/in/ IS checked in.
vxfmt/fuzz/out/
vxfmt/fuzz/harness
vxfmt/fuzz/harness-repl
vxfmt/fuzz/*.dSYM/

# Model training: the venv, the base model, the dataset and the
# intermediate GGUFs are all reproducible from tools/ and are far too
# large to track. assets/explain.gguf ships via a release, like the
# encyclopedia and the 0.5B model.
build/venv/
build/smol-base/
build/llama.cpp/
build/explainer*
build/dataset.jsonl
build/probe*.gguf
build/train.log

# Python bytecode from the host-side tools
__pycache__/
*.pyc

# The asset stamp disk.img depends on. Deliberately outside build/ so
# that `make clean` cannot trigger an 8 GB repack -- see the Makefile.
.assets.list

# WPE WebKit, fetched rather than vendored.
#
# libwpe is in the tree because it is eight thousand lines and a clone
# should build the same system in a year's time. The engine is some
# millions of lines and forty megabytes compressed, which is the same
# reason wiki.zim and qwen2.gguf are downloaded: GitHub refuses a blob
# over 100 MB, and git stores no useful delta for compressed data.
#
# `make webkit-fetch` brings it down and checks it against the SHA-256
# recorded in the Makefile.
third_party/wpewebkit-*/
build/wpewebkit-*.tar.xz
build/webkit/

# Downloaded by their own Makefile targets and verified against a
# checksum recorded there, exactly as WPE WebKit and the language models
# are. 131 MB between the three; a pinned download says the same thing as
# a committed copy and does not put it in everybody's clone.
third_party/sqlite/
third_party/freetype/
third_party/harfbuzz/
third_party/icu/
third_party/libjpeg/
third_party/libepoxy/
build/icu4c-*-src.tgz
third_party/libgpg-error/
third_party/libgcrypt/
third_party/libtasn1/
third_party/libxkbcommon/
third_party/xkeyboard-config/
third_party/libxml2/
third_party/zlib/
third_party/libpng/
