# Build artifacts
build/

# Generated ISO (distributed via GitHub Releases)
os.iso

# ISO root populated at build time
iso_root/boot/
iso_root/EFI/


# Extracted limine source tree
limine-12.3.2/

# macOS metadata
.DS_Store
**/.DS_Store

# Claude session data
.claude/

# Generated FAT32 system disk (user data lives here)
disk.img

# .vx toolchain binaries and example images
vxfmt/vx_maker
vxfmt/vx_run
vxfmt/*.o
vxfmt/*.bin
vxfmt/*.elf
vxfmt/*.vx
assets/

# Fuzzer working directory: AFL's queue, crashes and stats are session
# state, not source. The seed corpus in vxfmt/fuzz/in/ IS checked in.
vxfmt/fuzz/out/
vxfmt/fuzz/harness
vxfmt/fuzz/harness-repl
vxfmt/fuzz/*.dSYM/

# Model training: the venv, the base model, the dataset and the
# intermediate GGUFs are all reproducible from tools/ and are far too
# large to track. assets/explain.gguf ships via a release, like the
# encyclopedia and the 0.5B model.
build/venv/
build/smol-base/
build/llama.cpp/
build/explainer*
build/dataset.jsonl
build/probe*.gguf
build/train.log

# Python bytecode from the host-side tools
__pycache__/
*.pyc

# The asset stamp disk.img depends on. Deliberately outside build/ so
# that `make clean` cannot trigger an 8 GB repack -- see the Makefile.
.assets.list
